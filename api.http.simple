# REST Client Script — Forgot / Reset Password (Strapi) + Content CRUD
# ======================================================
# ส่วนที่ 1 = Admin, ส่วนที่ 2 = User (auth/forgot/reset), ส่วนที่ 3 = Content
# (Student / Subject / Teacher — Create, List All, List with ID, Update)
# 1) ดาวน์โหลด extension "REST Client" ใน VS Code ก่อน
# 2) สร้างไฟล์ .env จาก env.simple แล้วใส่ค่า email/password จริงของคุณ
# 3) เปิดไฟล์นี้ กด "Send Request" ตามลำดับข้อ
#
# หมายเหตุการแก้ตามมาตรฐาน IAAA (v2 - reset code ส่งออกนอก channel ทางอีเมล):
# - reset code มี TTL หมดอายุ 15 นาที - ถ้าเกินเวลาจะถูกปฏิเสธ และใช้ได้ครั้งเดียว
# - forgot-password/reset-password ต้องส่ง JWT (Bearer) จากการล็อคอิน (ข้อ 1.1 / 2.1)
#   และขอ reset ได้เฉพาะบัญชีตัวเองเท่านั้น (Reset เองจากคนอื่นไม่ได้)
# - reset code ส่งไปทางอีเมลเท่านั้น (Mailhog http://localhost:{{MAILHOG_WEB_PORT}})
#   ไม่มี code กลับมาใน HTTP response อีกต่อไป — หยิบ code จากอีเมลมาใส่ .env
# - code ไม่ถูกเก็บเป็นตัวเต็มใน DB (เก็บแค่ SHA-256 hash) - ฐานข้อมูลรั่วก็ใช้ไม่ได้
# - มี rate limit ทุก auth/forgot/reset - เดารหัสซ้ำไม่ได้
# - มี audit log (JSON line ใน data-audit/audit.log) ทุกการ login/forgot/reset password
# - เปลี่ยนรหัสผ่านสำเร็จ => JWT เก่าทุกตัวถูก revoke (ต้องล็อคอินใหม่)

## Variables
@baseUrl = http://localhost:{{$dotenv APP_PORT}}
@mailhog_web = http://localhost:{{$dotenv MAILHOG_WEB_PORT}}
@admin_email = {{$dotenv ADMIN_EMAIL}}
@admin_password = {{$dotenv ADMIN_PASSWORD}}
@admin_reset_code = {{$dotenv ADMIN_RESET_CODE}}
@admin_new_password = {{$dotenv ADMIN_NEW_PASSWORD}}
@admin_jwt = {{$dotenv ADMIN_JWT}}
@user_email = {{$dotenv USER_EMAIL}}
@user_password = {{$dotenv USER_PASSWORD}}
@user_reset_code = {{$dotenv USER_RESET_CODE}}
@user_new_password = {{$dotenv USER_NEW_PASSWORD}}
@user_jwt = {{$dotenv USER_JWT}}
@student_id = {{$dotenv STUDENT_ID}}
@subject_id = {{$dotenv SUBJECT_ID}}
@teacher_id = {{$dotenv TEACHER_ID}}

## 1. Admin

### 1.1 Login (เอา token จาก response มาใช้กับข้อ 1.3 - 1.3.1 อัตโนมัติ)
# @name adminLogin
POST {{baseUrl}}/admin/login
Content-Type: application/json

{
    "email": "{{admin_email}}",
    "password": "{{admin_password}}",
    "rememberMe": false
}

### 1.2 Register (admin) - ใช้ครั้งแรกตอนยังไม่มี admin เท่านั้น
POST {{baseUrl}}/admin/register-admin
Content-Type: application/json

{
    "firstname": "{{$dotenv ADMIN_FIRSTNAME}}",
    "lastname": "{{$dotenv ADMIN_LASTNAME}}",
    "email": "{{admin_email}}",
    "password": "{{admin_password}}"
}

### 1.3 Forgot Password (ต้องล็อคอินข้อ 1.1 ก่อน - ระบบส่ง reset code ไปอีเมล)
### เปิด {{mailhog_web}} ดูข้อความที่ inbox ส่งมา แล้วเอา code จากในอีเมลไปใส่ ADMIN_RESET_CODE ใน .env
POST {{baseUrl}}/admin/forgot-password
Content-Type: application/json
Authorization: Bearer {{adminLogin.response.body.$.data.token}}

{
    "email": "{{admin_email}}"
}

### 1.3.1 Reset Password (ใช้ ADMIN_RESET_CODE ที่คัดลอกจากอีเมล Mailhog ใส่ได้ทั้งแบบ encode %3A หรือ : ตรง ๆ ระบบ decode ให้เอง)
POST {{baseUrl}}/admin/reset-password
Content-Type: application/json
Authorization: Bearer {{adminLogin.response.body.$.data.token}}

{
    "resetPasswordToken": "{{admin_reset_code}}",
    "password": "{{admin_new_password}}"
}

### 1.3.2 หลังเปลี่ยนรหัสผ่าน JWT เก่าถูก revoke — ล็อคอินใหม่แล้วเอา token มาใส่ใน 1.4
### @name adminLoginAgain
POST {{baseUrl}}/admin/login
Content-Type: application/json

{
    "email": "{{admin_email}}",
    "password": "{{admin_new_password}}",
    "rememberMe": false
}

### 1.4 Profile
GET {{baseUrl}}/admin/users/me
Authorization: Bearer {{adminLoginAgain.response.body.$.data.token}}

## 2. User

### 2.1 Login (เอา token จาก response มาใช้กับข้อ 2.3 - 2.3.1 อัตโนมัติ)
# @name userLogin
POST {{baseUrl}}/api/auth/local
Content-Type: application/json

{
    "identifier": "{{user_email}}",
    "password": "{{user_password}}"
}

### 2.2 Register
POST {{baseUrl}}/api/auth/local/register
Content-Type: application/json

{
    "username": "{{$dotenv USER_USERNAME}}",
    "email": "{{user_email}}",
    "password": "{{user_password}}"
}

### 2.3 Forgot Password (ต้องล็อคอินข้อ 2.1 ก่อน - ระบบส่ง reset code ไปอีเมล)
### เปิด {{mailhog_web}} ดูข้อความที่ inbox ส่งมา แล้วเอา code จากในอีเมลไปใส่ USER_RESET_CODE ใน .env
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json
Authorization: Bearer {{userLogin.response.body.$.jwt}}

{
    "email": "{{user_email}}"
}

### 2.3.1 Reset Password (ใช้ USER_RESET_CODE ที่คัดลอกจากอีเมล Mailhog ใส่ได้ทั้งแบบ encode %3A หรือ : ตรง ๆ ระบบ decode ให้เอง)
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json
Authorization: Bearer {{userLogin.response.body.$.jwt}}

{
    "code": "{{user_reset_code}}",
    "password": "{{user_new_password}}",
    "passwordConfirmation": "{{user_new_password}}"
}

### 2.3.2 หลังเปลี่ยนรหัสผ่าน JWT เก่าถูก revoke — ล็อคอินใหม่แล้วเอา token มาใส่ใน 2.4
### @name userLoginAgain
POST {{baseUrl}}/api/auth/local
Content-Type: application/json

{
    "identifier": "{{user_email}}",
    "password": "{{user_new_password}}"
}

### 2.4 Profile
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{userLoginAgain.response.body.$.jwt}}

## 3. Content (Student / Subject / Teacher)
# ----------------------------------------------------------------------
# ทดสอบกับระบบจริงแล้ว ทุกข้อตอบ 200
# ถ้าได้ 403 แปลว่ายังไม่ได้ติ๊กสิทธิ์ ->
#   Admin > Settings > Users & Permissions > Role "Authenticated"
#
# 1) Authorization ต้องเป็น JWT ของ "user" (ข้อ 2.1 / 2.3.2) ไม่ใช่ admin token ข้อ 1.1
#    ถ้าไม่ส่ง token จะได้ 403 เพราะ Role "Public" ไม่มีสิทธิ์กับ content type นี้
#
# 2) field ที่กำหนด unique (mobile, cardId ของ student / name ของ subject)
#    ถ้าสร้างซ้ำจะได้ 400 ให้เปลี่ยนค่าใน body แล้วยิงใหม่
#
# 3) student มี lifecycle ที่แปลง mobile เป็น md5 ก่อนบันทึก
#    -> ค่าที่กลับมาใน response คือ hash ไม่ใช่เบอร์จริง
#    (ข้อสังเกต: md5 ไม่ควรใช้เก็บข้อมูลส่วนตัวจริง เพราะถอดกลับได้เร็ว
#     และเดาด้วย rainbow table ได้ ควรใช้ bcrypt / argon2)
#
# 4) สิทธิ์ delete ไม่ได้ติ๊กไว้ -> DELETE /api/students/{id} ตอบ 403
#    (least privilege ทำงาน)
#
# 5) response ของ Strapi v4 เป็น {"data":{"id":..,"attributes":{..}}}
#    เอาค่า "id" (ตัวเลข) ไปใส่ STUDENT_ID / SUBJECT_ID / TEACHER_ID ใน .env
# ----------------------------------------------------------------------

### 3.1 Student

#### 3.1.1 Create
POST {{baseUrl}}/api/students
Content-Type: application/json
Authorization: Bearer {{user_jwt}}

{
    "data": {
        "name": "สมชาย ใจดี",
        "mobile": "0801234567",
        "cardId": "1234567890123"
    }
}

#### 3.1.2 List All
GET {{baseUrl}}/api/students
Authorization: Bearer {{user_jwt}}

#### 3.1.3 List with ID
### เอา "id" ที่ได้จากข้อ 3.1.1 ไปใส่ STUDENT_ID ใน .env
GET {{baseUrl}}/api/students/{{student_id}}
Authorization: Bearer {{user_jwt}}

#### 3.1.4 Update
### ส่งเฉพาะฟิลด์ที่ต้องการแก้ ฟิลด์อื่นจะยังคงเดิม
PUT {{baseUrl}}/api/students/{{student_id}}
Content-Type: application/json
Authorization: Bearer {{user_jwt}}

{
    "data": {
        "name": "สมชาย ใจดี แก้ชื่อแล้ว"
    }
}

### 3.2 Subject

#### 3.2.1 Create
POST {{baseUrl}}/api/subjects
Content-Type: application/json
Authorization: Bearer {{user_jwt}}

{
    "data": {
        "name": "Cyber Security"
    }
}

#### 3.2.2 List All
GET {{baseUrl}}/api/subjects
Authorization: Bearer {{user_jwt}}

#### 3.2.3 List with ID
### เอา "id" ที่ได้จากข้อ 3.2.1 ไปใส่ SUBJECT_ID ใน .env
GET {{baseUrl}}/api/subjects/{{subject_id}}
Authorization: Bearer {{user_jwt}}

#### 3.2.4 Update
PUT {{baseUrl}}/api/subjects/{{subject_id}}
Content-Type: application/json
Authorization: Bearer {{user_jwt}}

{
    "data": {
        "name": "Cyber Security (Advanced)"
    }
}

### 3.3 Teacher

#### 3.3.1 Create
POST {{baseUrl}}/api/teachers
Content-Type: application/json
Authorization: Bearer {{user_jwt}}

{
    "data": {
        "name": "อาจารย์ ทดสอบ"
    }
}

#### 3.3.2 List All
GET {{baseUrl}}/api/teachers
Authorization: Bearer {{user_jwt}}

#### 3.3.3 List with ID
### เอา "id" ที่ได้จากข้อ 3.3.1 ไปใส่ TEACHER_ID ใน .env
GET {{baseUrl}}/api/teachers/{{teacher_id}}
Authorization: Bearer {{user_jwt}}

#### 3.3.4 Update
PUT {{baseUrl}}/api/teachers/{{teacher_id}}
Content-Type: application/json
Authorization: Bearer {{user_jwt}}

{
    "data": {
        "name": "อาจารย์ ทดสอบ แก้ชื่อแล้ว"
    }
}
