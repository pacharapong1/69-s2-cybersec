POSTGRES_PASSWORD=modified
POSTGRES_USER=modified
POSTGRES_DB=modified
POSTGRES_PORT=modified

PGADMIN_DEFAULT_EMAIL=modified
PGADMIN_DEFAULT_PASSWORD=modified
PGADMIN_DEFAULT_PORT=modified

# ---------- Mail (Mailhog - รับ email สำหรับ reset code) ----------
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025
EMAIL_DEFAULT_FROM=no-reply@localhost

DATABASE_HOST=modified
DATABASE_PORT=modified
DATABASE_NAME=modified
DATABASE_USERNAME=modified
DATABASE_PASSWORD=modified

APP_PORT=modified
HOSTNAME=localhost

# =====================================================================
# Credentials สำหรับทดสอบ REST Client (อ่านจาก .env ด้วย {{$dotenv ...}})
# =====================================================================

# ---------- Admin ----------
ADMIN_FIRSTNAME=modified
ADMIN_LASTNAME=modified
ADMIN_EMAIL=modified
ADMIN_PASSWORD=modified

# -- Forgot Password (Admin) --
# 1. ล็อคอินข้อ 1.1 ก่อน (REST Client จะจำ JWT ไว้ใช้ส่ง header Authorization เอง)
# 2. เรียกข้อ 1.3 Forgot Password -> ระบบส่ง reset code ไปทางอีเมล (ออกนอก channel)
#    เปิด http://localhost:{{MAILHOG_WEB_PORT}} ดูข้อความ แล้วเอา code จากในอีเมลมาใส่ ADMIN_RESET_CODE
# 3. ข้อ 1.3.1 จะนำ ADMIN_RESET_CODE ไปใช้ reset (รหัสมี TTL 15 นาที และใช้ได้ครั้งเดียว)
# 4. ตั้งรหัสผ่านใหม่ใน ADMIN_NEW_PASSWORD
#    หลัง reset สำเร็จ JWT เก่าทุกตัวของ admin จะถูก revoke (ต้องล็อคอินใหม่)
ADMIN_RESET_CODE=modified
ADMIN_NEW_PASSWORD=modified

# -- JWT Token (Admin) --
# ข้อ 1.3 / 1.3.1 / 1.4 ใช้ token ที่ REST Client จำจากข้อ 1.1 ให้อัตโนมัติ
# ค่านี้ใช้เมื่อจะยิงข้อ 1 โดยไม่ต้องรันข้อ 1.1 ก่อน (เช่นเปิดไฟล์ใหม่เป็นครั้งแรก)
ADMIN_JWT=modified

# ---------- User ----------
USER_USERNAME=modified
USER_EMAIL=modified
USER_PASSWORD=modified

# -- Forgot Password (User) --
# 1. ล็อคอินข้อ 2.1 ก่อน (REST Client จะจำ JWT ไว้ใช้ส่ง header Authorization เอง)
# 2. เรียกข้อ 2.3 Forgot Password -> ระบบส่ง reset code ไปทางอีเมล (ออกนอก channel)
#    เปิด http://localhost:{{MAILHOG_WEB_PORT}} ดูข้อความ แล้วเอา code จากในอีเมลมาใส่ USER_RESET_CODE
# 3. ข้อ 2.3.1 จะนำ USER_RESET_CODE ไปใช้ reset (รหัสมี TTL 15 นาที และใช้ได้ครั้งเดียว)
# 4. ตั้งรหัสผ่านใหม่ใน USER_NEW_PASSWORD
#    หลัง reset สำเร็จ JWT เก่าทุกตัวของ user จะถูก revoke (ต้องล็อคอินใหม่)
USER_RESET_CODE=modified
USER_NEW_PASSWORD=modified

# -- JWT Token (User) --
# ข้อ 2.3 / 2.3.1 ใช้ token ที่ REST Client จำจากข้อ 2.1 ให้อัตโนมัติ
# แต่ข้อ 3 (Content) จำเป็นต้องใช้ค่านี้เสมอ เพราะ content API ใช้สิทธิ์ของ
# Users & Permissions และต้องเป็น token ของ user ไม่ใช่ admin
# -> หลังล็อกอินสำเร็จในข้อ 2.1 (หรือ 2.3.2 หลังเปลี่ยนรหัส) ให้นำค่า jwt
#    จาก response มาใส่ใน USER_JWT
USER_JWT=modified

# =====================================================================
# Content (ข้อ 3) - ใช้กับ REST Client
# ---------------------------------------------------------------------
# ข้อ 3 ทุกข้อต้องส่ง Authorization: Bearer <USER_JWT> (token ของ user)
# ถ้าส่ง admin token จะได้ 401/403 เสมอ
# =====================================================================
# ---------- Student ----------
# ข้อมูลที่จะส่งใน 3.1.1 Create
# ข้อบังคับจาก schema (ไม่ตรงจะได้ 400):
#   - mobile = 10 ตัวพอดี + unique
#   - cardId = 13 ตัวพอดี + unique
#   - ค่าซ้ำกับที่มีอยู่แล้ว -> 400 "This attribute must be unique" ให้แก้ใน .env นี้แล้วยิงใหม่
# (ระบบจะแปลง mobile เป็น md5 ก่อนบันทึก แต่ค่าที่ส่งเข้าไปต้องเป็นเบอร์จริง)
# ตัวอย่าง: mobile=0801234567 (10) cardId=1234567890123 (13)
STUDENT_NAME=modified
STUDENT_MOBILE=modified
STUDENT_CARD_ID=modified

# ข้อมูลที่จะส่งใน 3.1.4 Update
STUDENT_NAME_UPDATED=modified

# หลังข้อ 3.1.1 Create สำเร็จ ให้เอา "id" (ตัวเลขใน response) มาใส่ค่านี้
# แล้วใช้ค่าเดียวกันในข้อ 3.1.3 (List with ID) และ 3.1.4 (Update)
# ไม่ใช่ documentId
STUDENT_ID=modified

# ---------- Subject ----------
# ข้อมูลที่จะส่งใน 3.2.1 Create (name ถูกบังคับ unique แต่ความยาวไม่จำกัด)
SUBJECT_NAME=modified

# ข้อมูลที่จะส่งใน 3.2.4 Update
SUBJECT_NAME_UPDATED=modified

# หลังข้อ 3.2.1 Create สำเร็จ ให้เอา "id" มาใส่ค่านี้
SUBJECT_ID=modified

# ---------- Teacher ----------
# ข้อมูลที่จะส่งใน 3.3.1 Create (name ไม่บังคับ unique ยิงซ้ำได้)
TEACHER_NAME=modified

# ข้อมูลที่จะส่งใน 3.3.4 Update
TEACHER_NAME_UPDATED=modified

# หลังข้อ 3.3.1 Create สำเร็จ ให้เอา "id" มาใส่ค่านี้
TEACHER_ID=modified

# =====================================================================
# Backend (Strapi) - ใช้สำหรับ app ไม่ใช่ REST Client
# =====================================================================
APP_KEYS=modified
JWT_SECRET=modified
ADMIN_JWT_SECRET=modified
API_TOKEN_SALT=modified
TRANSFER_TOKEN_SALT=modified